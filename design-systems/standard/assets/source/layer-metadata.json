  {
    "id": "45:27699",
    "name": "03｜課題提起",
    "nodes": [
      {
        "name": "課題の見出し",
        "type": "TEXT",
        "text": "情報が散らばる",
        "x": 80,
        "y": 451,
        "w": 450,
        "h": 49
      },
      {
        "name": "課題の要約",
        "type": "TEXT",
        "text": "必要な材料を探すところから、\n資料づくりが始まる",
        "x": 80,
        "y": 514,
        "w": 450,
        "h": 76
      },
      {
        "name": "課題の説明",
        "type": "TEXT",
        "text": "メモ、過去の提案、調査データが別々に\n保管され、最新版や必要な数字を探す\n手間が発生。材料の確認に追われ、\n肝心の検討を始める時間が減ります。",
        "x": 80,
        "y": 615,
        "w": 450,
        "h": 144
      },
      {
        "name": "課題の見出し",
        "type": "TEXT",
        "text": "順番が決まらない",
        "x": 575,
        "y": 451,
        "w": 450,
        "h": 49
      },
      {
        "name": "課題の要約",
        "type": "TEXT",
        "text": "ページを足すたびに、\n話の流れを組み直す",
        "x": 575,
        "y": 514,
        "w": 450,
        "h": 76
      },
      {
        "name": "課題の説明",
        "type": "TEXT",
        "text": "読み手の関心と情報の優先順位が\n定まらず、結論と根拠のつながりが\n曖昧に。追加や修正のたびに構成を\n見直すため、手戻りが増えます。",
        "x": 575,
        "y": 615,
        "w": 450,
        "h": 144
      },
      {
        "name": "課題の見出し",
        "type": "TEXT",
        "text": "見た目が揃わない",
        "x": 1070,
        "y": 451,
        "w": 450,
        "h": 49
      },
      {
        "name": "課題の要約",
        "type": "TEXT",
        "text": "最後の修正まで、\nサイズと位置の調整が続く",
        "x": 1070,
        "y": 514,
        "w": 450,
        "h": 76
      },
      {
        "name": "課題の説明",
        "type": "TEXT",
        "text": "文字の強弱、余白、図表の見せ方を\n都度判断。素材の追加や修正によって\nページ間の見た目がばらつき、\n仕上げの調整が長引きます。",
        "x": 1070,
        "y": 615,
        "w": 450,
        "h": 144
      },
